# AEGIS local security policy
AEGIS_REQUIRE_SANDBOX=1
AEGIS_DENY_UPLOAD_DOWNLOAD=1
AEGIS_ALLOW_ONLY_LOCAL_INPUT=1
AEGIS_BLOCKED_COMMANDS="curl wget scp sftp ftp rsync nc ncat netcat"
AEGIS_ALLOWED_COMMANDS="echo ls cat grep awk sed head tail pwd date uname whoami"
AEGIS_MAX_RETRY=3
AEGIS_TIMEOUT_SECONDS=15
AEGIS_BASELINE_LOCK=1
AEGIS_BLOCK_URL_ARGS=1
AEGIS_TELEMETRY_MODE="local-only"
AEGIS_GUARD_INTERVAL_SECONDS=5
AEGIS_AUTO_RESTORE_ON_INTEGRITY_FAIL=1
